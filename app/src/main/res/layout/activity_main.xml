<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top App Header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_surface"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copiloto Entrevista IA"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Javier Viveros • Senior Full-Stack IA"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status Chip (Listening / Paused) -->
        <TextView
            android:id="@+id/tvHeaderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_idle"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="⏸ EN PAUSA"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <!-- Language toggle button -->
        <TextView
            android:id="@+id/tvHeaderLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_language"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="🌐 ES"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Frame (holds the 4 tab views) -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ============================================== -->
        <!-- TAB 1: EN VIVO (LIVE COPILOT)                  -->
        <!-- ============================================== -->
        <ScrollView
            android:id="@+id/tabLive"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Listening Main Toggle Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleListening"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="🎙️ INICIAR ESCUCHA ACTIVA"
                    android:textColor="@color/on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="14dp" />

                <!-- Detected Voice / Manual Edit Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Voz detectada / Pregunta:"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvManualEditHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️ Editable"
                            android:textColor="@color/text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Editable detected text box -->
                    <EditText
                        android:id="@+id/etDetectedQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="75dp"
                        android:maxHeight="130dp"
                        android:background="@drawable/bg_edittext"
                        android:padding="12dp"
                        android:gravity="top|start"
                        android:hint="@string/voice_detected_placeholder"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_dim"
                        android:textSize="14sp"
                        android:inputType="textMultiLine|textCapSentences"
                        android:scrollbars="vertical"
                        android:layout_marginBottom="8dp" />

                    <!-- Send & Clear Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendQuestion"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="@string/send_to_gemini"
                            android:textColor="@color/on_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/accent_green"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearQuestion"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="@string/clear"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/bg_card_stroke" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Quick Questions Chips (Horizontal Scroll) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ PREGUNTAS RÁPIDAS FRECUENTES:"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipSwitchCisco"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Switch Cisco"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            app:strokeColor="@color/bg_card_stroke"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipRag"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Arquitectura RAG"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            app:strokeColor="@color/bg_card_stroke"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipVllm"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="vLLM &amp; Inferencia"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            app:strokeColor="@color/bg_card_stroke"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipCleanArch"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Clean Architecture"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            app:strokeColor="@color/bg_card_stroke"
                            android:layout_marginEnd="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/chipSueldo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Expectativa Salarial"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            app:strokeColor="@color/bg_card_stroke" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Teleprompter Result Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Teleprompter Header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🎯 TELEPROMPTER EN VIVO"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPrompterModelBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_badge_language"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:text="gemini-3.5-flash-lite"
                                android:textColor="@color/primary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Loading Indicator -->
                        <ProgressBar
                            android:id="@+id/pbLoading"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="4dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp" />

                        <!-- Teleprompter Main Answer Text -->
                        <TextView
                            android:id="@+id/tvTeleprompterText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/prompter_welcome_body"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp"
                            android:textIsSelectable="true"
                            android:layout_marginBottom="12dp" />

                        <!-- Follow-up / Refine Bar -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefineBrief"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/brief"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                app:strokeColor="@color/bg_card_stroke"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefineDetail"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/detail"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                app:strokeColor="@color/bg_card_stroke"
                                android:layout_marginEnd="6dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopyPrompter"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:text="@string/copy"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                app:strokeColor="@color/primary" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- TAB 2: HISTORIAL (CONVERSATIONS)               -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/tabHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- Search Bar & Clear All -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/etHistorySearch"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_edittext"
                    android:hint="🔍 Buscar en preguntas..."
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_dim"
                    android:textSize="13sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearHistory"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="🗑️ Borrar"
                    android:textColor="@color/accent_red"
                    android:textSize="12sp"
                    app:strokeColor="@color/bg_card_stroke" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHistoryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 preguntas registradas"
                android:textColor="@color/text_dim"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tvHistoryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no hay preguntas en el historial.\nLas preguntas que respondas en la reunión aparecerán aquí automáticamente."
                android:textColor="@color/text_dim"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="40dp"
                android:visibility="gone" />

            <!-- History RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- TAB 3: MI PITCH & FORMACIÓN                    -->
        <!-- ============================================== -->
        <ScrollView
            android:id="@+id/tabPitch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Profile Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Javier Viveros Huesca"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ingeniero Senior Full-Stack con IA"
                            android:textColor="@color/primary"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📧 viverosjavier86@gmail.com   📱 +52 (669) 533-0508\n📍 Mazatlán, Sinaloa, México (Remoto)"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="10dp" />

                        <!-- Salary & Availability Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#1510B981"
                            android:padding="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💰 EXPECTATIVA SALARIAL: $2,500 USD / mes (Contractor)"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏱️ DISPONIBILIDAD: Inmediata, tiempo completo remoto"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pitch Statement Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚀 PITCH DE POSICIONAMIENTO (PCoS / IA)"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tvPitchSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pitch text..."
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 7 Questions Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 7 PREGUNTAS DEL PROCESO (HIRELINE / ANGÉLICA):"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Questions RecyclerView (Nested) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPitchQuestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="14dp" />

                <!-- Work Experience Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💼 TRAYECTORIA Y ROLES PREVIOS:"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Empire Engineering -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Empire Engineering • Senior Full-Stack &amp; AI"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nov 2022 – Jul 2026 | Remoto EE.UU. (100% inglés)"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Lideró desarrollo con React, TypeScript, FastAPI y PostgreSQL.\n• Servido de Llama 3 y Mistral con vLLM en AWS GPU (-65% costos).\n• RAG con PostgreSQL pgvector, chunking semántico y rerankers (&lt;2% alucinaciones).\n• Lideró equipo de 5 ingenieros con Clean Architecture y CI/CD (&gt;85% pruebas)."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- AT&T -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AT&amp;T • Systems Tech Lead &amp; Software Engineer"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jun 2013 – Oct 2022 | México"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Arquitectura y supervisión de 120+ plataformas críticas (99.999% SLA).\n• APIs de alta concurrencia en Python (Flask/Django) con PostgreSQL y Oracle.\n• Ingesta con Ericsson y Huawei; coordinó equipo de 6 ingenieros bajo Scrum."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Nextel & Nokia -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nextel &amp; Nokia • Software Automation Engineer"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ene 2010 – May 2013 | México"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="• Scripts de automatización en Python y Bash para diagnóstico en Linux 24/7.\n• Bases de datos MySQL y resolución proactiva de incidentes bajo SLAs."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </ScrollView>

        <!-- ============================================== -->
        <!-- TAB 4: AJUSTES (SETTINGS)                      -->
        <!-- ============================================== -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- API Key Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔑 GOOGLE GEMINI API KEY"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="La clave se almacena de forma segura y local en tu celular:"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/etApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_edittext"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:hint="Pega tu API Key de Gemini..."
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_dim"
                            android:textSize="13sp"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveApiKey"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:text="💾 Guardar API Key"
                            android:textColor="@color/on_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Model & Language Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚙️ MODELO &amp; IDIOMA"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modelo de IA:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerModel"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_edittext"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Idioma de la Entrevista:"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            android:id="@+id/spinnerLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_edittext" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Hardware & Behavior Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/bg_card"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="@color/bg_card_stroke"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📱 COMPORTAMIENTO EN REUNIÓN"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="10dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swKeepScreenOn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mantener pantalla siempre encendida\n(Evita que el celular se bloquee)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:checked="true"
                            android:layout_marginBottom="10dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swVibration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Vibración táctil al recibir respuesta\n(Te avisa discretamente sin mirar)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:checked="true"
                            android:layout_marginBottom="10dp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swAutoSend"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Envío automático al detectar silencio\n(Si se desactiva, requieres pulsar Enviar)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:checked="true" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bg_surface"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/text_primary"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
